# keys and private data never enter git
.env
.env.*
!.env.example
secrets/
*.pem
*.key
.private-words
# tool folders (session logs must never be committed)
.claude/transcripts/
**/.claude/transcripts/
.claude/settings.local.json
.playwright-mcp/
# rebuildable
.cache/
node_modules/
.next/
.next-dev/
__pycache__/
.pytest_cache/
test-results/
playwright-report/
*.db
*.sqlite
*.log
.DS_Store
# per-project working data (each project keeps its own, outside the kit or git-ignored)
/project/
kit/rules/*.lock
# the demo tests also run the tools in the demo project itself: the database and the lock files they make stay out of git
examples/demo-site/project/state/
examples/demo-site/project/**/*.lock

# setup.sh may keep its tools inside the kit (GROWTH_VENV=./.venv, GROWTH_BIN=./.bin): never part of the repo
.venv/
.bin/

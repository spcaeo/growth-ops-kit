ALIASES = {"design": "site_design", "serve": "serve_build", "new-project": "new_project", "page-tracker": "page_tracker", "tracker": "page_tracker"}


MENU = """Growth Ops Kit: the commands you need

  growth setup [folder] [--site URL]   one-time setup: a few plain questions
  growth page <url-or-path>            start a page job (plan, checks, brief for your agent)
  growth check [path]                  check the page you are working on
  growth ready [path]                  is the page ready to show you?
  growth measure [path]                did the page help? (after it is live)
  growth status                        what is open, how far along, what is next

Start here:  growth setup --site https://your-site.example
Every other tool (there are over fifty):  growth help --all
"""
FRONT_DOOR = ("setup", "page", "check", "ready", "measure", "status")


def menu():
    print(MENU)


def usage():
    print(__doc__)
    print("Tools:")
    w = max(len(t) for t in TOOLS)
    for name, (_, line) in sorted(TOOLS.items()):
        print(f"  {name.replace('_', '-').ljust(w)}  {line}")
    print("\nPage tracker extras: growth page-tracker serve | report | ai-summary (see kit/page-tracker/README.md)")


def resolve(name):
    name = ALIASES.get(name, name).replace("-", "_")
    if name in TOOLS:
        return KIT / TOOLS[name][0]
    for sub in ("tools", "adapters/nextjs", "hooks"):
        for ext in (".py", ".sh"):
            if (KIT / sub / (name + ext)).is_file():
                return KIT / sub / (name + ext)
    return None


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        if "--all" in argv[1:]:
            usage()
        else:
            menu()
        return 0
    name, rest = argv[0], argv[1:]
    if name in FRONT_DOOR:
        return subprocess.call([python(), str(KIT / "tools" / "front_door.py"), name, *rest], env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"})
    if name == "hook":
        if rest[:1] == ["stage"]:        # PostToolUse hook: re-read the checkpoints at a stage boundary
            name, rest = "workflow", ["stage"]
        elif rest[:1] != ["stop"]:
            print("growth hook: say which hook. Available: stop, stage", file=sys.stderr)
            return 2
        else:
            rest = rest[1:]
    tool = resolve(name)
    if tool is None:
        print(f"growth: no tool '{name}'. Run: growth help", file=sys.stderr)
        return 2
    if tool.parent.name == "nextjs" and tool.parent.parent.name == "adapters":
        stack = project_stack()
        if stack and stack != "nextjs":
            print(f"SKIP: no adapter for {stack} (growth {name} reads a Next.js site's code; growth.json stack is {stack}).")
            return 0
    if name == "techseo" and rest[:1] == ["selftest"]:
        tool, rest = KIT / "tools" / "techseo" / "selftest.py", rest[1:]
    if tool.parent.name == "page-tracker":
        sub = {"serve": "serve.py", "report": "tracker.py", "ai-summary": "ai_summary.py", "ai_summary": "ai_summary.py"}
        if rest[:1] and rest[0] in ("serve", "ai-summary", "ai_summary"):
            tool, rest = tool.parent / sub[rest[0]], rest[1:]
    cmd = ["bash", str(tool), *rest] if tool.suffix == ".sh" else [python(), str(tool), *rest]
    env = dict(os.environ)
    env.setdefault("PYTHONDONTWRITEBYTECODE", "1")
    return subprocess.call(cmd, env=env)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
"""growth: the one command for the Growth Ops Kit.

  growth                      the few commands you need (setup, page, check, ready, measure, status)
  growth help --all           list every tool with one line each
  growth <tool> [args]        run kit/tools/<tool>.py (adapters and hooks too); hyphens and underscores both work
  growth gate page /x --url http://127.0.0.1:3801/x --type money
  growth new-project <folder> --site https://example.com
  growth wizard <folder> --site https://example.com     (the guided setup: does every step, resumes where it stopped)

Tools find the project from $GROWTH_PROJECT, else the nearest folder at or above the current one holding growth.json.
"""
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
KIT = ROOT / "kit"


def python():
    """The kit's own virtual environment (made by setup.sh, in $GROWTH_VENV or ~/.growth-ops-kit/venv) when it exists, else this Python."""
    venv = Path(os.environ.get("GROWTH_VENV") or Path.home() / ".growth-ops-kit" / "venv")
    for cand in (venv / "bin" / "python", venv / "Scripts" / "python.exe"):
        if cand.is_file():
            return str(cand)
    return sys.executable

def project_stack():
    """The stack named in the project's growth.json, or "" when there is no project (a tool may run inside a bare checkout)."""
    sys.path.insert(0, str(KIT / "tools"))
    try:
        import config
        proj = config.find_project()
        return (config.load_cfg(proj).get("stack") or "static").lower() if proj else ""
    except Exception:  # noqa: BLE001  a broken growth.json is reported by the tool itself
        return ""


